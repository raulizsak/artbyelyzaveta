# Canonical storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase — the publishable key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Modern sb_secret_ key preferred. Legacy service-role is fallback only.
SUPABASE_SECRET_KEY=

# Stripe TEST MODE only during this phase.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_TEST_CHECKOUT=false
ENABLE_LIVE_CHECKOUT=false

# Accounts and operations
ADMIN_EMAIL=
RATE_LIMIT_SECRET=

# Existing SMTP2GO account
SMTP2GO_API_KEY=
EMAIL_FROM=Art by Elyzaveta <hello@artbyelyzaveta.com>
# Keep in test mode until delivery is explicitly approved.
EMAIL_DELIVERY_MODE=test
EMAIL_TEST_RECIPIENT=

# Invoice/business settings. Leave GST/ABN blank unless legally applicable.
BUSINESS_NAME=Art by Elyzaveta
BUSINESS_ABN=
BUSINESS_ADDRESS=
BUSINESS_GST_REGISTERED=false
INVOICE_FOOTER=

# Keep search indexing off until the explicit production go-live.
ENABLE_SEARCH_INDEXING=false
