# Canonical storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Supabase — the publishable key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Modern sb_secret_ key preferred. Legacy service-role is fallback only.
SUPABASE_SECRET_KEY=

# Payment mode: demo, test, or live. Test/live are separately gated below.
PAYMENT_MODE=demo
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_WEBHOOK_SECRET=
ENABLE_TEST_CHECKOUT=false
ENABLE_LIVE_CHECKOUT=false

# Australia Post Track Items API (server-side only).
AUSTRALIA_POST_API_KEY=
AUSTRALIA_POST_API_PASSWORD=
AUSTRALIA_POST_ACCOUNT_NUMBER=
TRACKING_CRON_SECRET=
EMAIL_OUTBOX_TRIGGER_SECRET=

# Accounts and operations
ADMIN_EMAIL=
STORE_NOTIFICATION_EMAIL=hello@artbyelyzaveta.shop
RATE_LIMIT_SECRET=

# Existing SMTP2GO SMTP user used by the Render server.
SMTP2GO_SMTP_HOST=mail-au.smtp2go.com
SMTP2GO_SMTP_PORT=443
SMTP2GO_SMTP_USER=
SMTP2GO_SMTP_PASSWORD=
EMAIL_FROM=Art by Elyzaveta <noreply@artbyelyzaveta.shop>
EMAIL_DELIVERY_MODE=live
EMAIL_TEST_RECIPIENT=

# Invoice/business settings. Leave GST/ABN blank unless legally applicable.
BUSINESS_NAME=Art by Elyzaveta
BUSINESS_ABN=
BUSINESS_ADDRESS=
BUSINESS_GST_REGISTERED=false
INVOICE_FOOTER=

# Keep search indexing off until the explicit production go-live.
ENABLE_SEARCH_INDEXING=false

# Temporary pre-launch storefront gate. Keep the password and signing secret in Render only.
PREVIEW_GATE_ENABLED=false
PREVIEW_PASSWORD=
PREVIEW_COOKIE_SECRET=
