# Public Convex deployment URL, for example https://example.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# Canonical Render URL, for example https://art-by-elyzaveta.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by Convex CLI/CI deployments; do not expose this value to the browser.
CONVEX_DEPLOY_KEY=
